# --- secrets & local env ---
.env
.env.*
!.env.example
**/.env
!**/.env.example

# --- editor / OS ---
.DS_Store
.idea/
.vscode/
**/.cursor/
*.swp
*~

# --- Python / Node junk ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
**/node_modules/
**/dist/
*.log

# --- runtime outputs & jobs ---
**/outputs/
**/output/
**/jobs/
**/TEMP/
**/logs/
**/TEMP

# --- media / 资料类（音色 wav、上传资产、测试音视频）---
*.wav
*.mp3
*.flac
*.ogg
*.mp4
*.webm
*.mov
*.mkv
*.srt
*.pkl

# --- model weights & local model trees ---
**/GPT_weights*/
**/SoVITS_weights*/
**/*_weights/
**/vllm_models/
**/local_ollama/
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.onnx
**/*.tar
**/*.tar.gz

# vllm：只保留 compose
vllm/*
!vllm/docker-compose.ollama.yml
!vllm/docker-compose-vllm.yml

# egress-proxy：v2rayA 配置与订阅数据
egress-proxy/data/*
!egress-proxy/data/.gitkeep

# alist：数据库、令牌与存储配置
alist/data/*
!alist/data/.gitkeep

# g_ppt 运行产物与大素材（源码与 catalog 入仓）
g_ppt/assets/*
!g_ppt/assets/presenter/
g_ppt/assets/presenter/*
# presenter 视频属资料，不入仓；本地自行放置
!g_ppt/assets/presenter/.gitkeep

# nested git backups
**/.git.bak-before-support-monorepo/
