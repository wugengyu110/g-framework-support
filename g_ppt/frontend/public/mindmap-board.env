# 思维导图成片（board.html 上层）视觉；mindmap-video 渲染时读入
# 与 public/xing-xin-shen-tone.env（背景心行身球）分开调

# 是否嵌入 public 行心身动态图标作背景；false 时纯色底（见下）
USE_DYNAMIC_BG=false
# 关闭动态背景时的页面底色
SOLID_BG_COLOR=#27272a  

# 分区外框填充：color-mix(ink 与 transparent)，0–100，越大越实
GROUP_INK_MIX=50
# 分区描边：color-mix(ink 与 white)
GROUP_BORDER_INK_MIX=42

# 卡片底色不透明度 0–1（只稀释 --fill，文字仍不透明）
CARD_FILL_ALPHA=1
# 卡片描边：color-mix(ink 与 white)
CARD_BORDER_INK_MIX=38

# 导图连线（Obsidian edges）；会画在卡片之上
EDGE_STROKE_WIDTH=3.2
# 整条 path 的不透明度 0–1
EDGE_STROKE_OPACITY=1
