# 心行身演示成片配色：html.embed.tone-faint（?embed=1&tone=faint）时的透明度与淡色
# 改这里即可；浏览器预览会 fetch 本文件，mindmap-video 的 mp4 渲染同样读取并注入 CSS 变量
# 键名与 xing-xin-shen-demo.js 的 TONE_CSS、render_mindmap_video.py 的 TONE_CSS 一致

# 背景「行-心-身」三角连线（.link-line），不是导图卡片之间的连线
LINE_OPACITY=1
# 三色球圆盘（.ball-disk）不透明度；标签文字不受此项影响
BALL_DISK_OPACITY=1
# 球体投影（SVG feDropShadow flood-opacity）不透明度
BALL_SHADOW_OPACITY=0.08
# 整个舞台 SVG（#stage）不透明度，略压低以免压住上层导图
STAGE_OPACITY=0.9
# 主圆暗角（.arena-vignette）不透明度；0 表示成片时关闭暗角
ARENA_VIGNETTE_OPACITY=0
# 「行」球标签填色（#ball0 .ball-label），含 alpha 的 rgba
BALL_0_TEXT=rgba(133, 92, 20, 0.58)
# 「心」球标签填色（#ball1 .ball-label）
BALL_1_TEXT=rgba(151, 24, 47, 0.56)
# 「身」球标签填色（#ball2 .ball-label）
BALL_2_TEXT=rgba(14, 91, 76, 0.56)
# 场心「三休」水印字填色（.arena-watermark）
ARENA_WATERMARK_FILL=rgba(150, 195, 225, 0.72)
